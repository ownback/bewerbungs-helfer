    "dv": {"npm": "devicon", "version": "2.17.0", "path": "icons/<name>/<name>-<variant>.svg", "license": "MIT"},
    "si": {"npm": "simple-icons", "version": "15.0.0", "path": "icons/<name>.svg", "license": "CC0-1.0"}
  },
