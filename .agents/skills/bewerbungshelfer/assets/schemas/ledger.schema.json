{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ownback.local/schemas/ledger.schema.json",
  "title": "Bewerbungs-Ledger",
  "description": "Eine Datei pro Profil: profile/<vorname.nachname>/applications/ledger.json. Ein Eintrag pro erfasster Stelle, auch aussortierte. Das Ledger wird von tools/build_mappe.py aus den Stellenordnern abgeleitet (ledger sync); von Hand nur notes. Status, Ablage und Duplikatregel: references/applications.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "entries"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "profile": { "type": "string", "pattern": "^[a-z0-9-]+\\.[a-z0-9.-]+$", "description": "Ordnername des Profils, z. B. vorname.nachname." },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reference_number", "company", "title", "type", "folder", "status", "created_at"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "reference_number": { "type": "string", "description": "BA-Referenznummer; leer nur, wenn die Anzeige keine hat." },
          "company": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "occupation": { "type": "string" },
          "type": { "enum": ["apprenticeships", "jobs", "internships"] },
          "folder": {
            "type": "string",
            "pattern": "^applications/((sent|dropped)/)?(apprenticeships|jobs|internships)/[^/]+/[^/]+/\\d{2}-[a-z0-9-]+$",
            "description": "Pfad relativ zum Profilordner."
          },
          "search_city": { "type": "string" },
          "rank": { "type": "integer", "minimum": 1 },
          "status": { "enum": ["captured", "draft", "html_approved", "pdf_exported", "sent", "interview", "offer", "rejected", "withdrawn", "dropped"] },
          "created_at": { "type": "string", "format": "date", "description": "Datum des ersten Mappenbaus (Manifest), sonst der Erfassung (job.json source.retrieved_at)." },
          "deadline": { "type": "string", "description": "Bewerbungsfrist aus job.json, nur wenn dort ein Datum steht." },
          "html_approved_at": { "type": "string", "format": "date" },
          "pdf_exported_at": { "type": "string", "format": "date" },
          "sent_at": { "type": "string", "format": "date" },
          "dropped_at": { "type": "string", "format": "date" },
          "drop_reason": { "type": "string", "description": "Grund aus DROPPED.txt im Stellenordner." },
          "channel": { "enum": ["email", "post", "portal", "unknown"], "description": "Bewerbungsweg laut job.json; nach mark-sent der tatsächlich genutzte Kanal." },
          "open_blocking": { "type": "integer", "minimum": 0, "description": "Anzahl der Fragen in job.json mit severity blocking und status open." },
          "contact": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "email": { "type": "string" },
              "phone": { "type": "string" }
            }
          },
          "application_email": { "type": "string" },
          "source_url": { "type": "string" },
          "notes": { "type": "string", "description": "Einziges von Hand gepflegtes Feld; ledger sync übernimmt es aus dem vorhandenen Eintrag." },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["date", "status"],
              "properties": {
                "date": { "type": "string", "format": "date" },
                "status": { "enum": ["captured", "draft", "html_approved", "pdf_exported", "sent", "interview", "offer", "rejected", "withdrawn", "dropped"] },
                "note": { "type": "string" }
              }
            }
          }
        },
        "allOf": [
          { "if": { "properties": {"status": {"const": "sent"}} }, "then": { "required": ["sent_at", "channel"] } },
          { "if": { "properties": {"status": {"const": "dropped"}} }, "then": { "required": ["dropped_at", "drop_reason"] } }
        ]
      }
    }
  }
}
