{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ownback.local/schemas/application-manifest.schema.json",
  "title": "Bewerbungsmappe",
  "type": "object",
  "additionalProperties": false,
  "required": ["company", "role", "created_at", "html", "sections", "assets", "status"],
  "properties": {
    "company": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date" },
    "html": { "type": "string", "minLength": 1 },
    "sections": {
      "type": "array",
      "prefixItems": [
        { "const": "deckblatt" },
        { "const": "anschreiben" },
        { "const": "lebenslauf" },
        { "const": "motivationsschreiben" },
        { "const": "zertifikate" },
        { "const": "zeugnisse" }
      ],
      "minItems": 6,
      "maxItems": 6
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "kind", "section", "source"],
        "properties": {
          "file": { "type": "string" },
          "kind": { "enum": ["image", "pdf"] },
          "section": { "enum": ["zertifikate", "zeugnisse", "motivationsschreiben"] },
          "source": { "type": "string" },
          "caption": { "type": "string" }
        }
      }
    },
    "status": { "enum": ["draft", "html_approved", "pdf_exported", "ready_to_send"] },
    "approved_at": { "type": "string", "format": "date-time" },
    "open_questions": { "type": "array", "items": { "type": "string" } }
  }
}
