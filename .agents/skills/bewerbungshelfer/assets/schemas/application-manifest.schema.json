{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ownback.local/schemas/application-manifest.schema.json",
  "title": "Bewerbungsmappe",
  "type": "object",
  "additionalProperties": false,
  "required": ["company", "role", "created_at", "html", "sections", "assets", "status", "pages"],
  "properties": {
    "company": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date" },
    "html": { "type": "string", "minLength": 1 },
    "sections": {
      "type": "array",
      "prefixItems": [
        { "const": "deckblatt" },
        { "const": "anschreiben" },
        { "const": "lebenslauf" },
        { "const": "motivationsschreiben" },
        { "const": "zertifikate" },
        { "const": "zeugnisse" }
      ],
      "minItems": 6,
      "maxItems": 6,
      "description": "Die sechs Abschnitte in fester Reihenfolge. Seiten können mehr sein (Folgeseiten), siehe pages."
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "kind", "section", "source", "role"],
        "properties": {
          "file": { "type": "string" },
          "kind": { "enum": ["image", "pdf"] },
          "section": {
            "enum": ["deckblatt", "anschreiben", "lebenslauf", "motivationsschreiben", "zertifikate", "zeugnisse"]
          },
          "source": { "type": "string" },
          "caption": { "type": "string" },
          "role": { "enum": ["evidence", "photo", "signature", "project_image"] },
          "evidence_id": { "type": "string", "description": "ID aus profile.evidence" }
        }
      }
    },
    "status": { "enum": ["draft", "html_approved", "pdf_exported", "ready_to_send"] },
    "approved_at": { "type": "string", "format": "date-time" },
    "open_questions": { "type": "array", "items": {"type": "string"} },
    "pages": {
      "type": "array",
      "minItems": 6,
      "description": "Tatsächliche A4-Seiten in Reihenfolge. Folgeseiten nur für weitere Nachweise oder eine Lebenslauf-Fortsetzung.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "section"],
        "properties": {
          "number": { "type": "integer", "minimum": 1 },
          "section": {
            "enum": ["deckblatt", "anschreiben", "lebenslauf", "motivationsschreiben", "zertifikate", "zeugnisse"]
          },
          "continuation": { "type": "boolean" }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile_schema_valid": { "type": "boolean" },
        "job_schema_valid": { "type": "boolean" },
        "placeholders_remaining": { "type": "integer", "minimum": 0 },
        "overflow_pages": { "type": "array", "items": {"type": "integer"} },
        "a4_preview": { "type": "string", "description": "Pfad zur A4-Vorschau (PDF oder Seitenbilder)" },
        "checked_at": { "type": "string", "format": "date-time" }
      }
    },
    "pdf": { "type": "string" },
    "pdf_exported_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": {"status": {"enum": ["html_approved", "pdf_exported", "ready_to_send"]}} },
      "then": { "required": ["approved_at"] }
    },
    {
      "if": { "properties": {"status": {"enum": ["pdf_exported", "ready_to_send"]}} },
      "then": { "required": ["pdf", "pdf_exported_at"] }
    }
  ]
}
